# VibeYeah backend —— 环境变量示例
#
# 仅 DATABASE_URL 与 BIND_ADDR 从环境变量读取；
# 其余全部运行配置存于数据库 `settings` 表（key/value）：
# 迁移 m20240019_create_settings 会创建该表并写入默认值，
# 运维可在表中集中修改，修改后重启 backend 生效。

# 数据库连接串。支持 PostgreSQL 或 SQLite：
#   - PostgreSQL：postgres://user:pass@host:5432/dbname
#   - SQLite：sqlite://path/to/file.db
# 留空时默认使用本地 SQLite 文件 sqlite://vibeyeah.db（相对工作目录，首次连接自动创建）
DATABASE_URL=postgres://postgres:password@localhost:5432/vibeyeah

# 服务监听地址
BIND_ADDR=0.0.0.0:8080

# ── settings 表（key/value）中的配置键 ─────────────────────────────
# 除 DATABASE_URL / BIND_ADDR 外，以下键均在 settings 表中，不再读环境变量：
#   jwt_secret             JWT 密钥（必填；留空则拒绝启动）
#   jwt_expire_hours        JWT 有效期（小时），默认 72
#   lark_app_id             全局飞书 OAuth 应用 App ID（网页登录）
#   lark_app_secret         全局飞书 OAuth 应用 App Secret
#   k8s_namespace           默认 namespace
#   pod_sync_interval_secs  pod 状态同步间隔（秒），默认 30
#   sms_access_key_id       短信服务商 AccessKey（预留，当前未使用）
#   sms_access_key_secret   短信服务商 Secret
#   sms_sign_name           短信签名
#   sms_template_code       短信模板号
#   desktop_image           agent 桌面镜像
#   sidecar_image           WebRTC sidecar 镜像
#   nas_mount_root          NAS 在 backend 容器内的挂载点
#   nas_pvc_name            挂载进 agent pod 的共享 NAS PVC
#   webrtc_base_url         桌面实时观看基础 URL
#   hermes_exec_timeout_secs 回调触发 pod 内 hermes 的超时（秒），默认 900
#   callback_token          外部回调 /callback 的可选鉴权令牌（留空则不校验）
